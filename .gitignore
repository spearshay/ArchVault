# A content-only plugin has no build output, but ignore these defensively
# in case the plugin is ever opened inside a code project context.
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# Python bytecode cache (regenerated on import; machine/version specific)
__pycache__/
*.pyc

# OS / editor cruft
*.tmp
Thumbs.db
.DS_Store
